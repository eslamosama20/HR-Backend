{
  "info": {
    "name": "Pharmacy — Items & Insurance",
    "description": "Endpoints لبحث الأدوية، الدُفعات، فحص المخزون، والتأمين — SmartAndPro ERP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "description": "Base URL للسيرفر"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN",
      "description": "JWT Bearer Token من /api/auth/login"
    },
    {
      "key": "store_id",
      "value": "00000000-0000-0000-0000-000000000000",
      "description": "StoreDetailsId (Guid) من جدول StoreDetails"
    },
    {
      "key": "prescription_id",
      "value": "00000000-0000-0000-0000-000000000000",
      "description": "Prescription Id (Guid)"
    },
    {
      "key": "insurance_company_id",
      "value": "00000000-0000-0000-0000-000000000000",
      "description": "PharmacyInsuranceCompany Id (Guid)"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Items",
      "description": "بحث الأدوية وعرض الدُفعات وفحص المخزون",
      "item": [
        {
          "name": "1 — Search Items (بحث بالاسم أو الكود)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/pharmacy/items/lookup?searchTerm=باراسيتامول&storeId={{store_id}}&isControlled=false&maxResults=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pharmacy", "items", "lookup"],
              "query": [
                {
                  "key": "searchTerm",
                  "value": "باراسيتامول",
                  "description": "اسم أو كود الدواء (عربي أو إنجليزي أو ReferenceCode)"
                },
                {
                  "key": "storeId",
                  "value": "{{store_id}}",
                  "description": "Guid المخزن (اختياري)"
                },
                {
                  "key": "isControlled",
                  "value": "false",
                  "description": "true = أدوية مضبوطة فقط"
                },
                {
                  "key": "maxResults",
                  "value": "20",
                  "description": "الحد الأقصى للنتائج"
                }
              ]
            },
            "description": "البحث في كتالوج الأدوية (MainPurchaseClass حيث IsPharmacyItem=true) مع الكمية المتاحة من جدول PharmacyBatch."
          },
          "response": [
            {
              "name": "200 OK — نتائج البحث",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"items\": [\n    {\n      \"itemId\": 123456789,\n      \"itemCode\": \"MED-001\",\n      \"tradeName\": \"Paracetamol 500mg\",\n      \"scientificName\": \"باراسيتامول\",\n      \"strength\": null,\n      \"manufacturer\": null,\n      \"dosageForm\": null,\n      \"unitPrice\": 0.0,\n      \"stock\": 150.0,\n      \"availabilityStatus\": \"available\",\n      \"isControlled\": false,\n      \"requiresBatch\": true,\n      \"allowNegative\": false,\n      \"barcode\": null\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "2 — Get Item Batches (دُفعات صنف)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/pharmacy/items/123456789/batches?storeId={{store_id}}&activeOnly=true",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pharmacy", "items", "123456789", "batches"],
              "query": [
                {
                  "key": "storeId",
                  "value": "{{store_id}}",
                  "description": "Guid المخزن"
                },
                {
                  "key": "activeOnly",
                  "value": "true",
                  "description": "true = الدُفعات غير المنتهية والكمية > 0 فقط"
                }
              ]
            },
            "description": "إرجاع كل دُفعات صنف معين في مخزن محدد. الـ itemId هو int ID مولَّد من ItemCode (FNV-1a hash) — يُستخرج من نتيجة Search Items."
          },
          "response": [
            {
              "name": "200 OK — الدُفعات",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"itemId\": 123456789,\n  \"itemName\": \"Paracetamol 500mg\",\n  \"batches\": [\n    {\n      \"batchId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n      \"batchNo\": \"BAT-2024-001\",\n      \"expiryDate\": \"2026-12-31T00:00:00Z\",\n      \"availableQuantity\": 100.0,\n      \"unitPrice\": 0.0,\n      \"supplierName\": null,\n      \"receivedDate\": null,\n      \"isExpired\": false,\n      \"isExpiringSoon\": false,\n      \"status\": \"active\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "3 — Check Stock (فحص توافر المخزون)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": 123456789,\n  \"storeId\": \"{{store_id}}\",\n  \"requestedQty\": 5.0\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/pharmacy/items/check-stock",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pharmacy", "items", "check-stock"]
            },
            "description": "فحص إذا كانت الكمية المطلوبة متاحة في المخزن. يُستخدم قبل صرف الوصفة."
          },
          "response": [
            {
              "name": "200 OK — متاح بالكامل",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"isAvailable\": true,\n  \"availableQty\": 100.0,\n  \"availabilityStatus\": \"full\",\n  \"alternatives\": []\n}"
            },
            {
              "name": "200 OK — متاح جزئياً",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"isAvailable\": true,\n  \"availableQty\": 3.0,\n  \"availabilityStatus\": \"partial\",\n  \"alternatives\": []\n}"
            },
            {
              "name": "200 OK — غير متاح",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"isAvailable\": false,\n  \"availableQty\": 0.0,\n  \"availabilityStatus\": \"unavailable\",\n  \"alternatives\": []\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Insurance",
      "description": "التحقق من التغطية التأمينية وإرسال الموافقة",
      "item": [
        {
          "name": "4 — Verify Insurance (التحقق من التأمين)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"insuranceCompanyId\": \"{{insurance_company_id}}\",\n  \"memberNo\": \"INS-2026-00123\",\n  \"items\": [\n    {\n      \"itemId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n      \"quantity\": 2.0,\n      \"unitPrice\": 25.50\n    },\n    {\n      \"itemId\": \"4ba85f64-5717-4562-b3fc-2c963f66afb7\",\n      \"quantity\": 1.0,\n      \"unitPrice\": 80.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/pharmacy/insurance/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pharmacy", "insurance", "verify"]
            },
            "description": "التحقق من تغطية شركة التأمين لأصناف الوصفة. يُرجع نسبة التغطية والمبالغ المحسوبة لكل صنف."
          },
          "response": [
            {
              "name": "200 OK — التأمين فعّال",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"isActive\": true,\n  \"rejectionReason\": null,\n  \"coveragePercentage\": 80.0,\n  \"patientSharePercentage\": 20.0,\n  \"totalAmount\": 131.0,\n  \"coveredAmount\": 104.80,\n  \"patientPayableAmount\": 26.20,\n  \"itemsCoverage\": [\n    {\n      \"itemId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n      \"isCovered\": true,\n      \"coveragePercentage\": 80.0,\n      \"amountCovered\": 40.80,\n      \"rejectionReason\": null\n    },\n    {\n      \"itemId\": \"4ba85f64-5717-4562-b3fc-2c963f66afb7\",\n      \"isCovered\": true,\n      \"coveragePercentage\": 80.0,\n      \"amountCovered\": 64.00,\n      \"rejectionReason\": null\n    }\n  ]\n}"
            },
            {
              "name": "200 OK — شركة تأمين غير موجودة",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"isActive\": false,\n  \"rejectionReason\": \"Insurance company not found\",\n  \"coveragePercentage\": 0,\n  \"patientSharePercentage\": 0,\n  \"totalAmount\": 0,\n  \"coveredAmount\": 0,\n  \"patientPayableAmount\": 0,\n  \"itemsCoverage\": []\n}"
            }
          ]
        },
        {
          "name": "5 — Submit Approval (إرسال رقم الموافقة)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prescriptionId\": \"{{prescription_id}}\",\n  \"approvalNo\": \"APP-2026-XYZ123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/pharmacy/insurance/submit-approval",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pharmacy", "insurance", "submit-approval"]
            },
            "description": "تسجيل رقم الموافقة التأمينية على الوصفة. يُحدِّث InsuranceApprovalNo و InsuranceStatus='approved' في جدول PharmacyPrescription."
          },
          "response": [
            {
              "name": "200 OK — نجاح",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Approval submitted successfully\",\n  \"status\": \"approved\"\n}"
            },
            {
              "name": "200 OK — وصفة غير موجودة",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": false,\n  \"message\": \"Prescription not found\",\n  \"status\": \"failed\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
