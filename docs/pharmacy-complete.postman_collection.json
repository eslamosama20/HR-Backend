          }
        },
        {
          "name": "5.3 Update Prescription Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"dispensing\", \"notes\": \"\" }"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/pharmacy/prescriptions/{{prescription_id}}/status",
