              "raw": "{ \"reason\": \"طلب المريض\" }"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/pharmacy/prescriptions/{{prescription_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pharmacy", "prescriptions", "{{prescription_id}}", "cancel"]
            }
          }
        }
      ]
    },
